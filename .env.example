# ---------------------------------------------------------------------------
# HealthFolio environment configuration
# Copy this file to `.env` and adjust as needed. `.env` is gitignored.
# NOTE: these defaults are for the LOCAL PROTOTYPE only. Do not use in prod.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_tracker
# Optional for Prisma migrations on hosted Postgres/Supabase. In production,
# set DATABASE_URL to the pooled runtime URL and DIRECT_URL to the direct DB URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/medical_tracker

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-64-char-random-in-real-deploy
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Local KMS substitute (dev only)
LOCAL_ENCRYPTION_KEY_PATH=./.dev-keys/master.key

# Object storage substitute
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/storage

# Auth
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3002
WS_PORT=3001

# Doctor-share web
DOCTOR_SHARE_PORT=3002
DOCTOR_SHARE_URL=http://localhost:3002
DOCTOR_SHARE_API_URL=http://localhost:3000

# OCR (prototype)
OCR_DRIVER=tesseract
OPENAI_API_KEY=sk-replace-with-real-key
OPENAI_OCR_MODEL=gpt-4.1-mini

# Supabase backend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
DOCUMENT_BUCKET=medical-documents
EXPORT_BUCKET=exports

# PHI scrubber — set to 1 ONLY in tests to disable scrubbing for assertions
PHI_SCRUB_OFF=0

# Mobile app reads these at build time via expo-constants
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
EXPO_PUBLIC_INBOUND_EMAIL_DOMAIN=records.example.com
EXPO_PUBLIC_INBOUND_EMAIL_ADDRESS_TEMPLATE=your-healthfolio-inbox+{alias}@gmail.com

# Email forwarding ingest
# Configure your inbound email provider to POST to:
# https://<project-ref>.supabase.co/functions/v1/inbound-email-ingest
EMAIL_INGEST_WEBHOOK_SECRET=replace-with-random-webhook-secret
INTERNAL_FUNCTION_SECRET=replace-with-random-internal-function-secret
