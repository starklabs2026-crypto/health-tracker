# Mobile reads EXPO_PUBLIC_* at build time (expo-constants).
# IMPORTANT: When testing with Expo Go on a PHYSICAL phone, localhost points at
# the phone, not your dev machine. Set these to your computer's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
#   EXPO_PUBLIC_WS_URL=ws://192.168.1.50:3001
# On an emulator/simulator on the same machine, localhost is fine.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3001
