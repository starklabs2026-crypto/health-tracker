# Mobile reads EXPO_PUBLIC_* at build time.
#
# Supabase is the MVP backend. These two values are safe public client values
# from Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://qojdeuacwkmlxmodeabt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Production OAuth callback configured in Supabase Auth redirect URLs:
# healthfolio://auth/callback

# Native Google Sign-In. The iOS URL scheme in app.json must also be replaced
# with the reversed iOS client id, e.g. com.googleusercontent.apps.123-abc.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-with-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Legacy API values are still used by family/share/export screens until those
# are moved to Supabase Edge Functions.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3001
