{
  "expo": {
    "name": "HealthFolio",
    "owner": "starklabs",
    "slug": "healthfolio",
    "scheme": "healthfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7FA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.asianol.healthfolio",
      "buildNumber": "80",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "HealthFolio uses the camera to scan lab reports, prescriptions, and other health documents you choose to upload.",
        "NSPhotoLibraryUsageDescription": "HealthFolio lets you select health document images from your photo library for upload and OCR.",
        "NSFaceIDUsageDescription": "HealthFolio uses Face ID to help protect access to your health records on this device.",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ORG.healthfolio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F7FA"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "HealthFolio uses the camera to scan health documents you choose to upload.",
          "photosPermission": "HealthFolio lets you select health document images from your photo library."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow HealthFolio to use Face ID to unlock your health records."
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.326783637021-rudet3065p0a78ffq9i3q6tvvjd97mo4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "publicConfig": {
        "supabaseUrl": "https://qojdeuacwkmlxmodeabt.supabase.co",
        "supabaseAnonKey": "sb_publishable_d-pZ2zQvS-0QA5KR5EdloA_KOw1MUoI",
        "googleIosClientId": "326783637021-rudet3065p0a78ffq9i3q6tvvjd97mo4.apps.googleusercontent.com",
        "googleWebClientId": "326783637021-jjghkjheca8bmmijkib2a7opv23ku6lj.apps.googleusercontent.com",
        "inboundEmailAddressTemplate": "test.healthfolio+{alias}@gmail.com"
      },
      "eas": {
        "projectId": "b06f1d7e-8692-4995-9a4f-8641dbffadbf"
      }
    }
  }
}
