{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "echo \"(mobile build is via EAS; skipped in monorepo build)\" && exit 0",
    "build:deps": "cd ../.. && npm -w @medical-tracker/shared-types run build && npm -w @medical-tracker/parameter-catalog run build",
    "build:ios": "npx --yes eas-cli@19 build --platform ios --profile production",
    "submit:ios": "npx --yes eas-cli@19 submit --platform ios --profile production --latest",
    "postinstall": "npm run build:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@medical-tracker/parameter-catalog": "*",
    "@medical-tracker/shared-types": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.51.0",
    "axios": "^1.7.4",
    "expo": "^55.0.26",
    "expo-apple-authentication": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.14",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.76.1",
    "react-native": "0.83.6",
    "react-native-otp-entry": "^1.8.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.10",
    "eslint-config-custom": "*",
    "typescript": "~5.9.2",
    "vitest": "^2.0.5"
  }
}
