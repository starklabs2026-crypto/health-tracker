{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@medical-tracker/parameter-catalog": "*",
    "@medical-tracker/phi-scrubber": "*",
    "@medical-tracker/shared-types": "*",
    "@prisma/client": "^5.19.1",
    "bullmq": "^5.12.0",
    "fuse.js": "^7.0.0",
    "ioredis": "^5.4.1",
    "pdfjs-dist": "^4.5.136",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "dotenv-cli": "^7.4.2",
    "eslint-config-custom": "*",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
