{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_ACCESS_TTL",
    "JWT_REFRESH_TTL",
    "LOCAL_ENCRYPTION_KEY_PATH",
    "STORAGE_DRIVER",
    "STORAGE_LOCAL_PATH",
    "STORAGE_PUBLIC_BASE_URL",
    "OTP_EXPIRY_SECONDS",
    "OTP_LENGTH",
    "API_PORT",
    "API_HOST",
    "WS_PORT",
    "DOCTOR_SHARE_PORT",
    "DOCTOR_SHARE_BASE_URL",
    "OCR_DRIVER",
    "PHI_SCRUB_OFF",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_WS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
